# ═══════════════════════════════════════════════════════════
#  Luanti AI Agent — .gitignore
# ═══════════════════════════════════════════════════════════

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
.venv*/
venv*/

# 运行时数据（自动生成，不纳入版本控制）
data/
logs/
models/*.pt
models/*.pth

# 保留空目录的占位文件
!models/.gitkeep
!logs/.gitkeep

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# 系统文件
Thumbs.db
